<Window x:Class="ClubControl.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClubControl Lite" Height="800" Width="1280" MinWidth="900" MinHeight="560"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Small pill in the header: a coloured dot plus a live counter -->
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ChipTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- One card per PC. Selection and hover are drawn as a coloured outline. -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SelectionBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title + live counters -->
        <DockPanel Grid.Row="0" Margin="2,0,2,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="22" FontWeight="Bold" TextWrapping="NoWrap">
                <Run Text="CLUB" Foreground="{StaticResource AccentBrush}" /><Run Text="CONTROL" />
            </TextBlock>
            <StackPanel x:Name="ComputerChips" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource StateIdleBrush}" />
                        <TextBlock x:Name="StatFreeText" Style="{StaticResource ChipTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource StateRunningBrush}" />
                        <TextBlock x:Name="StatBusyText" Style="{StaticResource ChipTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource StateOfflineBrush}" />
                        <TextBlock x:Name="StatOfflineText" Style="{StaticResource ChipTextStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="NoClientChip" Style="{StaticResource ChipStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource StateNoClientBrush}" />
                        <TextBlock x:Name="StatNoClientText" Style="{StaticResource ChipTextStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="RepairChip" Style="{StaticResource ChipStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource StateRepairBrush}" />
                        <TextBlock x:Name="StatRepairText" Style="{StaticResource ChipTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ShiftDot" Width="9" Height="9" Fill="{StaticResource StateOfflineBrush}" />
                        <TextBlock x:Name="StatShiftText" Style="{StaticResource ChipTextStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock x:Name="SelectionCountText" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
        </DockPanel>

        <!-- The computers: action bar, cards, event log -->
        <Grid x:Name="ComputersPage" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="140" />
                <RowDefinition Height="Auto" />
                <!-- The event log: drag the bar above it to make it taller, or all the way down to hide it. -->
                <RowDefinition x:Name="LogRow" Height="110" MinHeight="0" />
            </Grid.RowDefinitions>

            <!-- Action bar -->
            <!-- One row always: when the window is narrow the whole bar shrinks (FitToolbar); only when it would get unreadable the buttons show just their icon -->
            <Border x:Name="ActionBar" Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="10,8" SizeChanged="OnActionBarSizeChanged">
                <DockPanel x:Name="ActionPanel">
                    <StackPanel x:Name="ActionRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                        <Button x:Name="ShiftButton" Margin="0,0,14,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnShiftToggle" />
                        <Button x:Name="SettingsButton" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="OnSettings" />
                        <Button x:Name="ReportsButton" Style="{StaticResource SecondaryButtonStyle}" Click="OnReports" />
                    </StackPanel>
                    <StackPanel x:Name="ActionLeft" Orientation="Horizontal">
                        <Button x:Name="StartButton" Margin="0,2,6,2" Style="{StaticResource SuccessButtonStyle}" Click="OnStart" />
                        <Button x:Name="StopButton" Margin="0,2,6,2" Style="{StaticResource DangerButtonStyle}" Click="OnStop" />
                        <Button x:Name="MoveButton" Margin="0,2,14,2" Style="{StaticResource SecondaryButtonStyle}" Click="OnMove" />
                        <Border Width="1" Background="{StaticResource DividerBrush}" Margin="0,2,14,2" />
                        <Button x:Name="TurnOnButton" Margin="0,2,6,2" Style="{StaticResource SecondaryButtonStyle}" Click="OnTurnOn" />
                        <Button x:Name="RestartButton" Margin="0,2,6,2" Style="{StaticResource SecondaryButtonStyle}" Click="OnRestart" />
                        <Button x:Name="ShutDownButton" Margin="0,2,0,2" Style="{StaticResource SecondaryButtonStyle}" Click="OnShutDown" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- PCs as cards -->
            <Border Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid Margin="8">
                <ListBox x:Name="PcList" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource CardItemStyle}"
                         PreviewMouseLeftButtonDown="PcList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="PcList_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="PcList_PreviewMouseLeftButtonUp"
                         MouseDoubleClick="PcList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="PcList_PreviewMouseRightButtonDown"
                         ContextMenuOpening="PcList_ContextMenuOpening"
                         SelectionChanged="PcList_SelectionChanged">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CtxStart" InputGestureText="Enter" Click="OnStart" />
                            <MenuItem x:Name="CtxStop" InputGestureText="Delete" Click="OnStop" />
                            <MenuItem x:Name="CtxMove" Click="OnMove" />
                            <Separator />
                            <MenuItem x:Name="CtxTurnOn" Click="OnTurnOn" />
                            <MenuItem x:Name="CtxRestart" Click="OnRestart" />
                            <MenuItem x:Name="CtxShutDown" Click="OnShutDown" />
                            <Separator />
                            <MenuItem x:Name="CtxReports" Click="OnReports" />
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Compact on purpose: 30 PCs must fit on one screen. Details are in the tooltip.
                                 Fixed size: 122 + the item's 4 border + 6 margin = 132 per card, so 10 fit in a row on a
                                 maximized 1600-wide window and the WrapPanel only starts a new row when the window
                                 is too narrow for 10. -->
                            <Grid x:Name="CardRoot" Width="122" Height="62" ToolTip="{Binding TooltipText}">
                                <!-- state tint + coloured left edge -->
                                <Border Background="{Binding AccentBrush}" Opacity="0.12" CornerRadius="10" />
                                <Border Width="4" HorizontalAlignment="Left" Background="{Binding AccentBrush}" CornerRadius="10,0,0,10" />

                                <Grid Margin="12,5,6,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- The number is docked first so it always keeps its room; the state text gets what is
                                         left and is trimmed with "..." if it is too long (full text is in the tooltip). -->
                                    <DockPanel Grid.Row="0">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding CardTitle}" FontSize="20" FontWeight="Bold" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="78" />
                                        <TextBlock Text="{Binding CardStateDisplay}" Foreground="{Binding AccentBrush}"
                                                   FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   TextAlignment="Right" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <TextBlock Grid.Row="1" Text="{Binding PrimaryDisplay}" FontSize="15" FontWeight="Bold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MinHeight="20" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Border>

            <!-- Status + event log -->
            <GridSplitter x:Name="LogSplitter" Grid.Row="2" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False" Cursor="SizeNS"
                          DragCompleted="LogSplitter_DragCompleted" MouseDoubleClick="LogSplitter_MouseDoubleClick">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent">
                            <Border Width="56" Height="4" CornerRadius="2" Background="{StaticResource DividerBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,8" ClipToBounds="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Starting..." />
                        <TextBlock x:Name="EventLogHeaderText" FontWeight="SemiBold" />
                    </DockPanel>
                    <ListBox x:Name="EventLogList" BorderThickness="0" FontFamily="Consolas" Background="Transparent" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
